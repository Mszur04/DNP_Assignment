<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Forum</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Posts
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="posts/create">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Create Post
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <AuthorizeView>
                <Authorized>
                    <span class="nav-link">Signed in as @context.User.Identity?.Name</span>
                    <button class="nav-link btn btn-link" style="text-align:left" @onclick="LogoutAsync">Log out</button>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Log in
                    </NavLink>
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    [Inject] private AuthenticationStateProvider AuthProvider { get; set; } = default!;
    [Inject] private NavigationManager NavMgr { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await ((BlazorApp.Auth.SimpleAuthProvider)AuthProvider).Logout();
        NavMgr.NavigateTo("/");
    }
}
