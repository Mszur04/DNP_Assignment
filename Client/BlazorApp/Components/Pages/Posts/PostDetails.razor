@page "/posts/{Id:int}"
@using System.Security.Claims
@using ApiContracts.Comments
@using ApiContracts.Posts
@using BlazorApp.HttpServices.Comments
@using BlazorApp.HttpServices.Posts
@using Microsoft.AspNetCore.Components.Authorization
@inject IPostService PostService
@inject ICommentService CommentService
@inject NavigationManager NavMgr

<PageTitle>@(post?.Title ?? "Post")</PageTitle>

@if (errorMessage is not null)
{
    <p style="color:red">@errorMessage</p>
}

@if (post is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@post.Title</h1>
    <p class="text-muted">by @post.AuthorUsername</p>
    <p>@post.Body</p>

    @if (isOwner)
    {
        <a class="btn btn-secondary btn-sm" href="@($"posts/{post.Id}/edit")">Edit post</a>
        <button class="btn btn-danger btn-sm" @onclick="DeletePostAsync">Delete post</button>
    }

    <hr />
    <h3>Comments (@(post.Comments?.Count ?? 0))</h3>

    @if (post.Comments is null || post.Comments.Count == 0)
    {
        <p><em>No comments yet.</em></p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (CommentDto comment in post.Comments)
            {
                <li class="list-group-item">
                    <strong>@comment.AuthorUsername:</strong> @comment.Body
                    @if (comment.UserId == currentUserId)
                    {
                        <button class="btn btn-link btn-sm text-danger" @onclick="() => DeleteCommentAsync(comment.Id)">delete</button>
                    }
                </li>
            }
        </ul>
    }

    <AuthorizeView>
        <Authorized>
            <div class="mb-3">
                <label>Add a comment:</label>
                <textarea class="form-control" style="max-width:500px" rows="3" @bind="newCommentBody"></textarea>
                <button class="btn btn-primary mt-2" @onclick="AddCommentAsync">Add comment</button>
            </div>
        </Authorized>
        <NotAuthorized>
            <p><a href="login">Log in</a> to add a comment.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private PostDto? post;
    private string newCommentBody = string.Empty;
    private string? errorMessage;
    private int currentUserId;
    private bool isOwner => post is not null && post.UserId == currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadPostAsync();
    }

    private async Task LoadCurrentUserAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        AuthenticationState authenticationState = await AuthState;
        ClaimsPrincipal claimsPrincipal = authenticationState.User;
        string? userIdAsString = claimsPrincipal.Claims.SingleOrDefault(c => c.Type == "Id")?.Value;
        if (userIdAsString is not null)
        {
            currentUserId = int.Parse(userIdAsString);
        }
    }

    private async Task LoadPostAsync()
    {
        try
        {
            post = await PostService.GetPostAsync(Id, includeComments: true);
        }
        catch (Exception e)
        {
            errorMessage = $"Could not load post: {e.Message}";
        }
    }

    private async Task AddCommentAsync()
    {
        errorMessage = null;
        try
        {
            await CommentService.AddCommentToPostAsync(Id, new AddCommentToPostDto
            {
                Body = newCommentBody,
                UserId = currentUserId
            });
            newCommentBody = string.Empty;
            await LoadPostAsync();
        }
        catch (Exception e)
        {
            errorMessage = $"Could not add comment: {e.Message}";
        }
    }

    private async Task DeleteCommentAsync(int commentId)
    {
        errorMessage = null;
        try
        {
            await CommentService.DeleteCommentAsync(commentId);
            await LoadPostAsync();
        }
        catch (Exception e)
        {
            errorMessage = $"Could not delete comment: {e.Message}";
        }
    }

    private async Task DeletePostAsync()
    {
        errorMessage = null;
        try
        {
            await PostService.DeletePostAsync(Id);
            NavMgr.NavigateTo("/");
        }
        catch (Exception e)
        {
            errorMessage = $"Could not delete post: {e.Message}";
        }
    }
}
